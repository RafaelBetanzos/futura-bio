---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;

const links = [
  { href: '/producto', label: 'Producto' },
  { href: '/sobre-nosotros', label: 'Sobre Nosotros' },
  { href: '/articulos', label: 'Artículos' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-100">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <div class="flex items-center justify-between h-[74px]">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0">
        <img
          src={`${base}/assets/logos/Logo FuturaBio.svg`}
          alt="FuturaBio®"
          class="h-10 w-auto"
        />
      </a>

      <!-- Nav links (desktop) -->
      <nav class="hidden md:flex items-center gap-8">
        {links.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'text-sm transition-colors',
              path.includes(href)
                ? 'text-neutral-900 font-medium'
                : 'text-neutral-500 hover:text-neutral-900',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- CTA (desktop) + hamburger (mobile) -->
      <div class="flex items-center gap-4">
        <a href="/comprar" class="hidden md:flex bg-futura-dark text-white text-sm font-medium px-5 py-2 items-center gap-2 hover:opacity-90 transition-opacity">
          Comprar
          <img src={`${base}/assets/icons/Carrito.svg`} alt="" class="w-4 h-4 brightness-0 invert" />
        </a>

        <!-- Hamburger button -->
        <button
          id="menu-toggle"
          aria-label="Abrir menú"
          aria-expanded="false"
          class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-1.5"
        >
          <span class="hamburger-line block w-6 h-0.5 bg-neutral-800 transition-all duration-300"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-neutral-800 transition-all duration-300"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-neutral-800 transition-all duration-300"></span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-neutral-100 bg-white/95 backdrop-blur-sm"
  >
    <nav class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-1">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'py-3 text-base border-b border-neutral-100 transition-colors',
            path.includes(href)
              ? 'text-neutral-900 font-medium'
              : 'text-neutral-500',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href="/comprar"
        class="mt-4 bg-futura-dark text-white text-sm font-medium px-5 py-3 flex items-center justify-center gap-2"
      >
        Comprar
        <img src={`${base}/assets/icons/Carrito.svg`} alt="" class="w-4 h-4 brightness-0 invert" />
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const lines = toggle?.querySelectorAll('.hamburger-line');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));

    if (isOpen && lines) {
      (lines[0] as HTMLElement).style.transform = 'translateY(8px) rotate(45deg)';
      (lines[1] as HTMLElement).style.opacity = '0';
      (lines[2] as HTMLElement).style.transform = 'translateY(-8px) rotate(-45deg)';
    } else if (lines) {
      (lines[0] as HTMLElement).style.transform = '';
      (lines[1] as HTMLElement).style.opacity = '';
      (lines[2] as HTMLElement).style.transform = '';
    }
  });

  // Close menu on navigation
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      if (lines) {
        (lines[0] as HTMLElement).style.transform = '';
        (lines[1] as HTMLElement).style.opacity = '';
        (lines[2] as HTMLElement).style.transform = '';
      }
    });
  });
</script>
