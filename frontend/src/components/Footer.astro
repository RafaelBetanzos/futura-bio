---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-futura-dark text-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-16 py-12">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-10">

      <!-- Logo + social -->
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block">
          <img
            src={`${base}/assets/logos/Logo FuturaBio.svg`}
            alt="FuturaBio®"
            class="h-9 w-auto brightness-0 invert"
          />
        </a>
        <div class="flex items-center gap-3">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <img src={`${base}/assets/icons/Instagram.svg`} alt="" class="w-7 h-7 brightness-0 invert opacity-70 hover:opacity-100 transition-opacity" />
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <img src={`${base}/assets/icons/Linkedin.svg`} alt="" class="w-7 h-7 brightness-0 invert opacity-70 hover:opacity-100 transition-opacity" />
          </a>
        </div>
      </div>

      <!-- Nav links with dividers -->
      <nav class="flex items-center flex-wrap gap-0 divide-x divide-white/20">
        <a href="/producto" class="px-4 first:pl-0 text-sm text-white/70 hover:text-white transition-colors">Productos</a>
        <a href="/sobre-nosotros" class="px-4 text-sm text-white/70 hover:text-white transition-colors">Sobre nosotros</a>
        <a href="/articulos" class="px-4 text-sm text-white/70 hover:text-white transition-colors">Artículos</a>
        <a href="/contacto" class="px-4 text-sm text-white/70 hover:text-white transition-colors">Contacto</a>
      </nav>

    </div>
  </div>
</footer>
