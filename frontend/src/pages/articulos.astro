---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Artículos de ejemplo — reemplazar con datos reales desde el CMS o archivos Markdown
const articulos = [
  { titulo: 'Beneficios del aceite de coco en el cuidado de la piel', img: 'Articulos01.png', href: '#' },
  { titulo: 'Centella asiatica: el ingrediente que regenera', img: 'Articulos01.png', href: '#' },
  { titulo: 'Cómo elegir una crema corporal según tu tipo de piel', img: 'Articulos01.png', href: '#' },
];
---

<BaseLayout
  title="Artículos — FuturaBio®"
  description="Artículos sobre ciencia, bienestar y cuidado natural de la piel. Contenido respaldado por FuturaBio®."
>

  <!-- Hero -->
  <section class="relative min-h-[480px] overflow-hidden">
    <img
      src={`${base}/assets/images/Articulos01.png`}
      alt="FuturaBio — Artículos"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-white/20"></div>
    <div class="relative page-container pt-20 pb-16">
      <h1 class="text-5xl md:text-6xl font-medium text-neutral-800">Artículos</h1>
    </div>
  </section>

  <!-- Grid de artículos -->
  <section class="page-section bg-white">
    <div class="page-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {articulos.map(({ titulo, img, href }) => (
          <a href={href} class="group block">
            <div class="aspect-[4/3] overflow-hidden bg-neutral-100 mb-4">
              <img
                src={`${base}/assets/images/${img}`}
                alt={titulo}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <h3 class="text-sm font-medium text-neutral-900 group-hover:text-futura-dark transition-colors">
              {titulo}
            </h3>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
