---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ingredientesIzq = [
  { nombre: 'Tocopherol',       beneficio: 'Antioxidante - Protege y fortalece la piel.' },
  { nombre: 'Coco nucifera OIL', beneficio: 'Humectación profunda y suavidad prolongada.' },
  { nombre: 'Arnica montana',   beneficio: 'Alivia y repara pequeñas abrasiones.' },
];

const ingredientesDer = [
  { nombre: 'Centella asiatica',     beneficio: 'Favorece la regeneración y mejora la apariencia de la piel.' },
  { nombre: 'Calendula officinalis', beneficio: 'Calma y repara - Ideal para pieles sensibles.' },
  { nombre: 'Mangifera indica',      beneficio: 'Nutrición intensa - Elasticidad y confort.' },
];
---

<BaseLayout
  title="Producto — FuturaBio®"
  description="Crema Equilibrio Natural. Formulada para todo tipo de piel con ingredientes de origen natural."
>

  <!-- Hero -->
  <section class="relative min-h-[600px] overflow-hidden bg-futura-cream flex items-center">
    <img
      src={`${base}/assets/images/Productos01.png`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-right"
    />
    <div class="relative page-container py-24">
      <div class="max-w-lg">
        <h1 class="text-5xl md:text-6xl font-medium text-neutral-800 leading-tight mb-4">
          Equilibrio diario<br/>para tu piel
        </h1>
        <p class="text-base text-neutral-600 mb-10">Innovación, bienestar y naturaleza</p>
        <a href="/comprar" class="btn-dark">Realiza tu compra aquí</a>
      </div>
    </div>
  </section>

  <!-- Detalle del producto -->
  <section class="page-section bg-white">
    <div class="page-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

        <!-- Imagen: mancha de crema -->
        <div class="flex justify-center">
          <img
            src={`${base}/assets/images/Productos02.png`}
            alt="Crema Equilibrio Natural — textura"
            class="w-full max-w-md object-contain"
          />
        </div>

        <!-- Info -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <p class="text-xs font-semibold tracking-widest text-neutral-400 uppercase">Daily Skincare</p>
            <img src={`${base}/assets/icons/Sol y Luna.svg`} alt="Uso día y noche" class="w-5 h-5" />
          </div>
          <h2 class="text-xl font-semibold text-neutral-900 tracking-wide mb-6">APTO TODO TIPO DE PIEL</h2>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Tu ritual diario de cuidado empieza aquí. Equilibrio Natural es una crema corporal formulada
            para todo tipo de piel. Su textura cremosa y de rápida absorción brinda humectación prolongada,
            dejando una sensación suave. Desarrollada por FuturaBio®, combina el poder de ingredientes de
            origen natural con fórmulas pensadas y probadas, enfocadas en el cuidado integral y el
            equilibrio de la piel.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="page-section bg-futura-cream">
    <div class="page-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

        <div>
          <h2 class="text-3xl md:text-4xl font-semibold text-neutral-900 mb-6">Beneficios</h2>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Una piel que se siente bien, se ve mejor. Equilibrio Natural aporta humectación
            intensa y de larga duración, mejorando visiblemente la textura, la luminosidad y la
            uniformidad de la piel desde las primeras aplicaciones. Ayuda a combatir la resequedad,
            brinda suavidad inmediata y acompaña los procesos naturales de regeneración cutánea. Su
            acción reparadora contribuye a aliviar pequeñas abrasiones y a mantener la piel saludable,
            equilibrada y confortable a lo largo del tiempo.
          </p>
        </div>

        <div class="flex justify-center lg:justify-end">
          <img
            src={`${base}/assets/images/Productos03.png`}
            alt="Crema Equilibrio Natural FuturaBio®"
            class="w-full max-w-md object-contain"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- Ingredientes -->
  <section class="page-section bg-white">
    <div class="page-container">
      <h2 class="text-3xl md:text-4xl font-semibold text-neutral-900 mb-10">Ingredientes</h2>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr_1fr] gap-8 items-center">

        <!-- Columna izquierda -->
        <div class="space-y-8">
          {ingredientesIzq.map(({ nombre, beneficio }) => (
            <div class="border-t border-neutral-200 pt-4">
              <p class="text-sm font-semibold text-neutral-800 uppercase tracking-wide mb-1">{nombre}</p>
              <p class="text-sm text-neutral-500 leading-relaxed">{beneficio}</p>
            </div>
          ))}
        </div>

        <!-- Centro: imagen petri dish — columna doble -->
        <div class="flex justify-center">
          <img
            src={`${base}/assets/images/Productos04.png`}
            alt="Ingredientes naturales de la Crema Equilibrio Natural"
            class="w-full object-contain"
          />
        </div>

        <!-- Columna derecha -->
        <div class="space-y-8">
          {ingredientesDer.map(({ nombre, beneficio }) => (
            <div class="border-t border-neutral-200 pt-4">
              <p class="text-sm font-semibold text-neutral-800 uppercase tracking-wide mb-1">{nombre}</p>
              <p class="text-sm text-neutral-500 leading-relaxed">{beneficio}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
