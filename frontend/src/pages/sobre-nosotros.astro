---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const equipo = [
  {
    nombre: 'Facundo Gulías',
    rol: 'Cofundador',
    bio: 'Científico y emprendedor. Lidera el desarrollo tecnológico y la investigación aplicada de FuturaBio®.',
    img: 'SobreNosotros04.png',
  },
  {
    nombre: 'Florencia A. Castello',
    rol: 'Cofundadora',
    bio: 'Especialista en ciencias biomédicas. Responsable del desarrollo y validación de las fórmulas de FuturaBio®.',
    img: 'SobreNosotros07.png',
  },
  {
    nombre: 'Rafael Betanzos',
    rol: 'Cofundador',
    bio: 'Emprendedor e innovador. Impulsa la estrategia comercial y la visión de mercado de FuturaBio®.',
    img: 'SobreNosotros06.png',
  },
];
---

<BaseLayout
  title="Sobre Nosotros — FuturaBio®"
  description="Conoce al equipo detrás de FuturaBio®. Científicos, innovadores y emprendedores comprometidos con el bienestar."
>

  <!-- Hero -->
  <section class="relative h-[480px] overflow-hidden">
    <img
      src={`${base}/assets/images/SobreNosotros01.png`}
      alt="FuturaBio — Sobre Nosotros"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-white/40"></div>
    <div class="relative page-container h-full flex items-end pb-16">
      <h1 class="text-5xl md:text-6xl font-medium text-neutral-800">sobre nosotros</h1>
    </div>
  </section>

  <!-- Misión + Visión -->
  <section class="page-section bg-white">
    <div class="page-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <div class="border border-neutral-200 p-10">
          <h2 class="text-xl font-semibold text-futura-dark mb-6 uppercase tracking-wide">Nuestra Misión</h2>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Impulsar la salud y el bienestar de las personas desarrollando y ofreciendo productos
            naturales, seguros y eficaces. Buscamos generar un impacto positivo y sostenible en la
            sociedad, actuando de manera ética y responsable en cada decisión y con el medio ambiente
            en cada acción.
          </p>
        </div>

        <div class="border border-neutral-200 p-10">
          <h2 class="text-xl font-semibold text-futura-dark mb-6 uppercase tracking-wide">Nuestra Visión</h2>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Convertirnos como la empresa en la innovación permanente y el cuidado humano, siendo
            líderes desde nuestra ciencia al servicio del bienestar de la humanidad con la
            investigación científica permanente.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Imagen full-width -->
  <section class="h-[420px] overflow-hidden">
    <img
      src={`${base}/assets/images/SobreNosotros02.png`}
      alt="FuturaBio — Ciencia aplicada"
      class="w-full h-full object-cover object-center"
    />
  </section>

  <!-- Ciencia aplicada -->
  <section class="page-section bg-white">
    <div class="page-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <div>
          <h2 class="text-3xl md:text-4xl font-medium text-neutral-900 mb-8">
            Ciencia aplicada al bienestar real
          </h2>
          <div class="space-y-5 text-sm text-neutral-600 leading-relaxed">
            <p>
              <strong class="text-neutral-800">Transformamos ciencia en bienestar cotidiano.</strong> En FuturaBio®
              nacemos desde la ciencia aplicada y la convicción de que la investigación de calidad debe
              convertirse en soluciones reales. Somos científicos y emprendedores que desarrollan productos
              naturales, seguros y eficaces, pensados para integrarse a la vida diaria.
            </p>
            <p>
              <strong class="text-neutral-800">El valor está en el origen.</strong> Cada desarrollo se apoya en
              investigación rigurosa, criterio tecnológico y una mirada de largo plazo. Funcionamos como
              el puente entre la ciencia y el mercado, convirtiendo innovación validada en soluciones
              accesibles, responsables y con impacto positivo.
            </p>
            <p>
              <strong class="text-neutral-800">Un modelo que se retroalimenta.</strong> Elegir FuturaBio® es elegir
              productos respaldados científicamente y, al mismo tiempo, impulsar la investigación, el
              desarrollo tecnológico y un ecosistema científico orientado al futuro.
            </p>
          </div>
        </div>

        <div class="lg:pt-4">
          <img
            src={`${base}/assets/images/SobreNosotros03.png`}
            alt="FuturaBio — Laboratorio"
            class="w-full object-cover"
          />
          <div class="mt-8 space-y-2">
            <p class="text-lg font-medium text-neutral-800">
              Ciencia que se convierte en producto. Productos que sostienen la ciencia.
            </p>
            <p class="text-sm text-neutral-500">FuturaBio®: Ciencia y Naturaleza.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- El Equipo -->
  <section class="page-section bg-futura-cream">
    <div class="page-container">
      <h2 class="text-3xl md:text-4xl font-medium text-neutral-900 text-center mb-16">EL EQUIPO</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        {equipo.map(({ nombre, rol, bio, img }) => (
          <div class="flex flex-col items-center text-center">
            <div class="w-48 h-48 rounded-full overflow-hidden mb-6 bg-neutral-200">
              <img
                src={`${base}/assets/images/${img}`}
                alt={nombre}
                class="w-full h-full object-cover object-top"
              />
            </div>
            <h3 class="text-base font-semibold text-neutral-900">{nombre}</h3>
            <p class="text-sm text-futura-dark font-medium mb-3">{rol}</p>
            <p class="text-sm text-neutral-600 leading-relaxed">{bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
