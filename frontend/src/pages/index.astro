---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const claims = [
  { icon: '01', label: 'Fórmula Natural' },
  { icon: '02', label: 'Científicamente probada' },
  { icon: '03', label: 'Todo tipo de piel' },
  { icon: '04', label: 'Absorción rápida' },
];
---

<BaseLayout title="FuturaBio® — Ciencia y Naturaleza para tu piel">

  <!-- Hero — video en loop -->
  <section class="h-[calc(100vh-74px)] overflow-hidden">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover object-center"
    >
      <source src={`${base}/assets/videos/hero.mp4`} type="video/mp4" />
      <!-- Fallback para navegadores sin soporte de video -->
      <img
        src={`${base}/assets/images/Inicio01.png`}
        alt="FuturaBio® — Crema Equilibrio Natural"
        class="w-full h-full object-cover object-center"
      />
    </video>
  </section>

  <!-- Producto intro -->
  <section class="page-section bg-white">
    <div class="page-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

        <div>
          <h2 class="text-4xl md:text-5xl font-medium leading-tight text-neutral-800 mb-5">
            Ciencia y Naturaleza para el cuidado de tu piel.
          </h2>
          <p class="text-base text-neutral-600 leading-relaxed mb-8 max-w-lg">
            Crema Equilibrio Natural ofrece humectación profunda y duradera para todo tipo de piel.
            Su fórmula de rápida absorción, desarrollada por FuturaBio®, mejora la suavidad y la
            luminosidad, acompaña la regeneración natural y promueve una piel visiblemente saludable
            y equilibrada.
          </p>
          <a href="/producto" class="btn-dark">Conocer más</a>
        </div>

        <div class="flex justify-center lg:justify-end">
          <img
            src={`${base}/assets/images/Inicio02.png`}
            alt="Crema Equilibrio Natural de FuturaBio®"
            class="w-full max-w-[480px] object-cover"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ¿Por qué nuestra crema? — fondo textura de crema + CTA compra -->
  <section class="relative page-section overflow-hidden">
    <img
      src={`${base}/assets/images/Inicio03.png`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <img
      src={`${base}/assets/images/Inicio04.png`}
      alt=""
      aria-hidden="true"
      class="absolute -right-16 -top-10 w-[520px] opacity-50 pointer-events-none select-none"
    />
    <div class="absolute inset-0 bg-white/20"></div>
    <div class="relative page-container text-center">
      <h2 class="text-3xl md:text-4xl font-medium text-neutral-800 mb-10">
        ¿Por qué nuestra crema Equilibrio Natural?
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-12">
        {claims.map(({ icon, label }) => (
          <div class="flex flex-col items-center gap-4">
            <img
              src={`${base}/assets/illustrations/Claims FuturaBio (ICONOS)-${icon}.svg`}
              alt={label}
              class="w-24 h-24"
            />
            <p class="text-sm font-medium text-neutral-700">{label}</p>
          </div>
        ))}
      </div>
      <a href="/comprar" class="btn-dark">Realiza tu compra aquí</a>
    </div>
  </section>

  <!-- Sobre nosotros — sección blanca separada -->
  <section class="page-section bg-white">
    <div class="page-container">
      <div class="max-w-xl">
        <h2 class="text-3xl md:text-4xl font-medium text-neutral-800 mb-6">Sobre nosotros</h2>
        <p class="text-base text-neutral-600 leading-relaxed mb-7">
          En FuturaBio® somos científicos, innovadores y emprendedores guiados por la curiosidad y
          el compromiso de crear soluciones que mejoren la vida de las personas.
        </p>
        <a href="/sobre-nosotros" class="btn-outline-dark">Conoce a nuestro equipo</a>
      </div>
    </div>
  </section>

</BaseLayout>
