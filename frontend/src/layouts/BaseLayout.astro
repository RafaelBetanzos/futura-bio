---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FuturaBio® — Ciencia y Naturaleza',
  description = 'Crema Equilibrio Natural. Formulada por FuturaBio® para todo tipo de piel. Humectación profunda con ingredientes de origen natural.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/logos/Logo FuturaBio.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Navbar />
    <main class="pt-[74px]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
